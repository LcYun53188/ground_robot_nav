<?xml version="1.0"?>
<sdf version="1.9">
  <model name="omni_base_mid360" xmlns:gz="http://gazebosim.org/schema">
    <link name="base_link">
      <inertial>
        <mass>18.0</mass>
        <inertia>
          <ixx>0.176904</ixx>
          <iyy>0.176904</iyy>
          <izz>0.2916</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <!-- Keep the collision hull slightly shallower than the visual body.
             The resulting 60 mm belly clearance prevents the chassis from
             catching the sharp ramp-to-platform transition. -->
        <geometry><cylinder><radius>0.18</radius><length>0.10</length></cylinder></geometry>
      </collision>
      <visual name="body">
        <geometry><cylinder><radius>0.18</radius><length>0.144</length></cylinder></geometry>
        <material>
          <ambient>0.04 0.18 0.55 1</ambient>
          <diffuse>0.05 0.25 0.85 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Gazebo cameras look along local +X. Positive pitch rotates +X toward
         the ground, so this mount faces forward with a 10-degree down tilt. -->
    <link name="oakd_camera_link">
      <pose relative_to="base_link">0.18 0 0.22 0 0.1745329252 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0002</ixx>
          <iyy>0.0002</iyy>
          <izz>0.0002</izz>
        </inertia>
      </inertial>
      <visual name="camera_body">
        <geometry><box><size>0.07 0.10 0.035</size></box></geometry>
        <material>
          <ambient>0.55 0.15 0.01 1</ambient>
          <diffuse>0.95 0.32 0.03 1</diffuse>
        </material>
      </visual>
      <visual name="left_lens">
        <pose>0.038 0.028 0 0 0 0</pose>
        <geometry><box><size>0.008 0.022 0.022</size></box></geometry>
        <material>
          <ambient>0.01 0.01 0.015 1</ambient>
          <diffuse>0.01 0.01 0.015 1</diffuse>
        </material>
      </visual>
      <visual name="right_lens">
        <pose>0.038 -0.028 0 0 0 0</pose>
        <geometry><box><size>0.008 0.022 0.022</size></box></geometry>
        <material>
          <ambient>0.01 0.01 0.015 1</ambient>
          <diffuse>0.01 0.01 0.015 1</diffuse>
        </material>
      </visual>
      <sensor name="oakd_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/oakd/imu/raw</topic>
        <gz_frame_id>oakd_imu_link</gz_frame_id>
      </sensor>
      <sensor name="oakd_rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>rgbd_camera</topic>
        <camera>
          <horizontal_fov>1.21</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
          </image>
          <clip>
            <near>0.20</near>
            <far>8.0</far>
          </clip>
          <optical_frame_id>oakd_camera_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>
    <joint name="oakd_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>oakd_camera_link</child>
    </joint>

    <!-- This is a raster GPU-lidar approximation of a Livox MID360. The
         mounting pose and scan envelope follow the reference simulator, but
         it does not emulate Livox's non-repetitive sampling or per-point time.
         It is mounted 0.16 m from the chassis center at the front-right
         (-45 degree) position. Its horizontal yaw remains 45 degrees. -->
    <link name="mid360_link">
      <pose relative_to="base_link">0.113137085 -0.113137085 0.18 0.5235987756 0 0.7853981634</pose>
      <inertial>
        <mass>0.265</mass>
        <inertia>
          <ixx>0.00035</ixx>
          <iyy>0.00035</iyy>
          <izz>0.00035</izz>
        </inertia>
      </inertial>
      <visual name="body">
        <geometry><cylinder><radius>0.04</radius><length>0.04</length></cylinder></geometry>
        <material>
          <ambient>0.02 0.38 0.08 1</ambient>
          <diffuse>0.04 0.75 0.16 1</diffuse>
        </material>
      </visual>
      <sensor name="mid360_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/mid360/imu</topic>
        <gz_frame_id>mid360_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.0002</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.017</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="mid360_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>20</update_rate>
        <topic>/mid360</topic>
        <gz_frame_id>mid360_link</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>1875</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>6.2831853072</max_angle>
            </horizontal>
            <vertical>
              <samples>32</samples>
              <resolution>1</resolution>
              <min_angle>-0.1221730476</min_angle>
              <max_angle>0.9075712110</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.10</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="mid360_fixed_joint" type="fixed">
      <parent>base_link</parent>
      <child>mid360_link</child>
    </joint>

    <link name="front_left_wheel">
      <pose relative_to="base_link">0.19 0.19 -0.04 -1.5707 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>0.6</mu2><fdir1 gz:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
    </link>
    <link name="front_right_wheel">
      <pose relative_to="base_link">0.19 -0.19 -0.04 -1.5707 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>0.6</mu2><fdir1 gz:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
    </link>
    <link name="rear_left_wheel">
      <pose relative_to="base_link">-0.19 0.19 -0.04 -1.5707 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>0.6</mu2><fdir1 gz:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
    </link>
    <link name="rear_right_wheel">
      <pose relative_to="base_link">-0.19 -0.19 -0.04 -1.5707 0 0</pose>
      <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <surface><friction><ode><mu>2.0</mu><mu2>0.6</mu2><fdir1 gz:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
      <front_left_joint>front_left_wheel_joint</front_left_joint>
      <front_right_joint>front_right_wheel_joint</front_right_joint>
      <back_left_joint>rear_left_wheel_joint</back_left_joint>
      <back_right_joint>rear_right_wheel_joint</back_right_joint>
      <wheel_separation>0.38</wheel_separation>
      <wheelbase>0.38</wheelbase>
      <wheel_radius>0.07</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/model/omni_base/wheel_odometry</odom_topic>
      <tf_topic>/model/omni_base/wheel_tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <min_acceleration>-1.5</min_acceleration>
      <max_acceleration>1.5</max_acceleration>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <!-- Preserve chassis Z, roll and pitch on ramps. nvblox requires the
           full camera pose to integrate depth without turning rising terrain
           into a false vertical obstacle. Nav2 still plans in odom XY. -->
      <dimensions>3</dimensions>
      <odom_topic>/visual_slam/tracking/odometry</odom_topic>
      <tf_topic>/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>front_left_wheel_joint</joint_name>
      <joint_name>front_right_wheel_joint</joint_name>
      <joint_name>rear_left_wheel_joint</joint_name>
      <joint_name>rear_right_wheel_joint</joint_name>
      <topic>/joint_states</topic>
      <update_rate>30</update_rate>
    </plugin>
  </model>
</sdf>
