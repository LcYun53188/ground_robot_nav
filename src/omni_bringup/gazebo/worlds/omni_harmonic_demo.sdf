<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="omni_harmonic_demo">
    <physics name="fast_step" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>18 18</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>20</mu>
                <mu2>20</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>18 18</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.57 0.58 1</ambient>
            <diffuse>0.55 0.57 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_wall_front">
      <static>true</static>
      <pose>2.4 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.18 2.4 0.9</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.18 2.4 0.9</size></box></geometry>
          <material>
            <ambient>0.65 0.28 0.22 1</ambient>
            <diffuse>0.65 0.28 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_wall_left">
      <static>true</static>
      <pose>0.8 1.6 0.35 0 0 0.65</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.8 0.16 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.8 0.16 0.7</size></box></geometry>
          <material>
            <ambient>0.22 0.48 0.56 1</ambient>
            <diffuse>0.22 0.48 0.56 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="box_wall_right">
      <static>true</static>
      <pose>-1.0 -1.55 0.35 0 0 -0.45</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.7 0.16 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.7 0.16 0.7</size></box></geometry>
          <material>
            <ambient>0.45 0.36 0.16 1</ambient>
            <diffuse>0.45 0.36 0.16 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="center_column">
      <static>true</static>
      <pose>0.2 -0.35 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.22</radius><length>0.9</length></cylinder></geometry>
          <material>
            <ambient>0.28 0.34 0.62 1</ambient>
            <diffuse>0.28 0.34 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="low_box_obstacle">
      <static>true</static>
      <pose>-1.7 0.45 0.18 0 0 0.25</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.70 0.55 0.36</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.55 0.36</size></box></geometry>
          <material>
            <ambient>0.50 0.22 0.48 1</ambient>
            <diffuse>0.50 0.22 0.48 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="omni_base" xmlns:gz="http://gazebosim.org/schema">
      <pose>0 0 0.11 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>18.0</mass>
          <inertia>
            <ixx>0.36</ixx>
            <iyy>0.42</iyy>
            <izz>0.60</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.55 0.45 0.18</size></box></geometry>
        </collision>
        <visual name="body">
          <geometry><box><size>0.55 0.45 0.18</size></box></geometry>
          <material>
            <ambient>0.1 0.22 0.28 1</ambient>
            <diffuse>0.1 0.22 0.28 1</diffuse>
          </material>
        </visual>

        <sensor name="oakd_imu" type="imu">
          <always_on>true</always_on>
          <update_rate>200</update_rate>
          <topic>/oakd/imu/raw</topic>
        </sensor>
      </link>

      <link name="oakd_camera_optical_frame">
        <pose>0.18 0 0.22 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
          </inertia>
        </inertial>
        <visual name="camera_body">
          <geometry><box><size>0.07 0.10 0.035</size></box></geometry>
          <material>
            <ambient>0.02 0.02 0.025 1</ambient>
            <diffuse>0.02 0.02 0.025 1</diffuse>
          </material>
        </visual>
        <sensor name="oakd_rgbd" type="rgbd_camera">
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>rgbd_camera</topic>
          <camera>
            <horizontal_fov>1.21</horizontal_fov>
            <image>
              <width>640</width>
              <height>400</height>
            </image>
            <clip>
              <near>0.20</near>
              <far>8.0</far>
            </clip>
            <optical_frame_id>oakd_camera_optical_frame</optical_frame_id>
          </camera>
        </sensor>
      </link>

      <joint name="oakd_fixed_joint" type="fixed">
        <parent>base_link</parent>
        <child>oakd_camera_optical_frame</child>
      </joint>

      <link name="front_left_wheel">
        <pose>0.19 0.19 -0.04 -1.5707 0 0</pose>
        <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
      </link>

      <link name="front_right_wheel">
        <pose>0.19 -0.19 -0.04 -1.5707 0 0</pose>
        <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
      </link>

      <link name="rear_left_wheel">
        <pose>-0.19 0.19 -0.04 -1.5707 0 0</pose>
        <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
      </link>

      <link name="rear_right_wheel">
        <pose>-0.19 -0.19 -0.04 -1.5707 0 0</pose>
        <inertial><mass>0.8</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="collision">
          <geometry><sphere><radius>0.07</radius></sphere></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 gz:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><cylinder><radius>0.07</radius><length>0.045</length></cylinder></geometry></visual>
      </link>

      <joint name="front_left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>front_left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="front_right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>front_right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="rear_left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>rear_left_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
      <joint name="rear_right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>rear_right_wheel</child>
        <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>

      <plugin filename="gz-sim-mecanum-drive-system" name="gz::sim::systems::MecanumDrive">
        <front_left_joint>front_left_wheel_joint</front_left_joint>
        <front_right_joint>front_right_wheel_joint</front_right_joint>
        <back_left_joint>rear_left_wheel_joint</back_left_joint>
        <back_right_joint>rear_right_wheel_joint</back_right_joint>
        <wheel_separation>0.38</wheel_separation>
        <wheelbase>0.38</wheelbase>
        <wheel_radius>0.07</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/visual_slam/tracking/odometry</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>50</odom_publish_frequency>
        <min_acceleration>-1.5</min_acceleration>
        <max_acceleration>1.5</max_acceleration>
      </plugin>

      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <joint_name>front_left_wheel_joint</joint_name>
        <joint_name>front_right_wheel_joint</joint_name>
        <joint_name>rear_left_wheel_joint</joint_name>
        <joint_name>rear_right_wheel_joint</joint_name>
        <topic>/joint_states</topic>
        <update_rate>30</update_rate>
      </plugin>
    </model>
  </world>
</sdf>
