+  declareMultiMapperParameters(node.get());
+
+  const auto result = node->set_parameter(
+    rclcpp::Parameter("multi_mapper.max_ground_plane_slope_deg", 45.0));
+  ASSERT_TRUE(result.successful);
+  const auto reversed_result = node->set_parameter(
+    rclcpp::Parameter("multi_mapper.min_reversed_traversable_slope_deg", 5.0));
+  ASSERT_TRUE(reversed_result.successful);
+  const auto elevation_result = node->set_parameter(rclcpp::Parameter(
+    "multi_mapper.traversable_elevation_height_tolerance_m", 0.02));
+  ASSERT_TRUE(elevation_result.successful);
+
+  const MultiMapperParams params = getMultiMapperParamsFromROS(node.get());
+  EXPECT_FLOAT_EQ(params.max_ground_plane_slope_deg.get(), 45.0f);
+  EXPECT_FLOAT_EQ(
+    params.min_reversed_traversable_slope_deg.get(), 5.0f);
+  EXPECT_FLOAT_EQ(
+    params.traversable_elevation_height_tolerance_m.get(), 0.02f);
+}
