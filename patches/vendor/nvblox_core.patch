+/// Return whether a TSDF surface gradient represents a surface within the
+/// configured traversable slope. Upward gradients are accepted directly.
+/// Reversed gradients are accepted only above a minimum nonzero slope because
+/// projective TSDF signs can flip when a ramp is observed from below. This
+/// keeps nearly horizontal downward-facing surfaces (for example, the bottom
+/// of a low overhang) classified as obstacles.
+__host__ __device__ inline bool isTsdfSurfaceGradientTraversable(
+    const Vector3f& gradient, float min_traversable_normal_z,
+    float max_reversed_traversable_normal_z) {
+  constexpr float kMinSquaredGradientNorm = 1e-8f;
+  constexpr float kComparisonTolerance = 1e-5f;
+  const float squared_norm = gradient.squaredNorm();
+  if (squared_norm <= kMinSquaredGradientNorm) {
+    return false;
+  }
+  const float norm = sqrtf(squared_norm);
+  const float normalized_z = gradient.z() / norm;
+  const float min_z = min_traversable_normal_z - kComparisonTolerance;
+  if (normalized_z > 0.0f) {
+    return normalized_z >= min_z;
+  }
+  const float reversed_normal_z = -normalized_z;
+  return reversed_normal_z >= min_z &&
+         reversed_normal_z <=
+             max_reversed_traversable_normal_z + kComparisonTolerance;
+}
