+/// Interpolate the height of a TSDF zero crossing between two vertically
+/// adjacent observed samples. The sign order is intentionally ignored so the
+/// elevation estimate is independent of the camera viewing direction.
+__host__ __device__ inline bool calculateTsdfZeroCrossingHeight(
+    float lower_height_m, float lower_distance, float upper_height_m,
+    float upper_distance, float* crossing_height_m) {
+  constexpr float kMinDistanceDifference = 1e-8f;
+  if ((lower_distance < 0.0f && upper_distance < 0.0f) ||
+      (lower_distance > 0.0f && upper_distance > 0.0f)) {
+    return false;
+  }
+  const float distance_difference = lower_distance - upper_distance;
+  if (fabsf(distance_difference) <= kMinDistanceDifference) {
+    *crossing_height_m = 0.5f * (lower_height_m + upper_height_m);
+    return true;
+  }
+  const float interpolation = lower_distance / distance_difference;
+  if (interpolation < 0.0f || interpolation > 1.0f) {
+    return false;
+  }
+  *crossing_height_m =
+      lower_height_m + interpolation * (upper_height_m - lower_height_m);
+  return true;
