+/// Estimate one TSDF gradient component from the nearest observed samples on
+/// either side of a surface voxel. Central differences are preferred, while a
+/// one-sided difference keeps sparse depth boundaries classifiable.
+__host__ __device__ inline bool calculateTsdfGradientComponent(
+    float center_distance, bool lower_valid, float lower_distance,
+    int lower_offset_vox, bool upper_valid, float upper_distance,
+    int upper_offset_vox, float* gradient_component) {
+  lower_valid = lower_valid && lower_offset_vox > 0;
+  upper_valid = upper_valid && upper_offset_vox > 0;
+  if (lower_valid && upper_valid) {
+    *gradient_component =
+        (upper_distance - lower_distance) /
+        static_cast<float>(lower_offset_vox + upper_offset_vox);
+    return true;
+  }
+  if (upper_valid) {
+    *gradient_component =
+        (upper_distance - center_distance) /
+        static_cast<float>(upper_offset_vox);
+    return true;
+  }
+  if (lower_valid) {
+    *gradient_component =
+        (center_distance - lower_distance) /
+        static_cast<float>(lower_offset_vox);
+    return true;
+  }
+  return false;
